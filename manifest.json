{
  "manifest_version": 3,
  "name": "No Numbers for X",
  "description": "Hide engagement counts on X without disabling the engagement buttons.",
  "version": "1.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
